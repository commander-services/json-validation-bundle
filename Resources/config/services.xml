<?xml version="1.0" encoding="UTF-8"?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="commander_json_validation.validator"
                 class="Commander\JsonValidationBundle\JsonValidator\JsonValidator">
            <argument type="service" id="file_locator"/>
            <argument>%kernel.project_dir%</argument>
            <argument>%commander_json_validation.validator.resolver_register_files%</argument>
            <argument>%commander_json_validation.validator.resolver_register_prefixes%</argument>
        </service>
        <service id="commander_json_validation.request_listener"
                 class="Commander\JsonValidationBundle\EventListener\ValidateJsonRequestListener">
            <argument type="service" id="commander_json_validation.validator"/>
        </service>
        <service id="commander_json_validation.response_listener"
                 class="Commander\JsonValidationBundle\EventListener\ValidateJsonResponseListener">
            <argument type="service" id="commander_json_validation.validator"/>
            <argument type="service" id="logger"/>
        </service>
        <service id="commander_json_validation.exception_listener"
                 class="Commander\JsonValidationBundle\EventListener\ValidateJsonExceptionListener">
            <argument type="service" id="logger"/>
        </service>
        <service id="Commander\JsonValidationBundle\JsonValidator\JsonValidator"
                 alias="commander_json_validation.validator"
                 public="true">
        </service>
    </services>

</container>
