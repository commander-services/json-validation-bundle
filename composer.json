{
    "name": "commander/json-validation-bundle",
    "description": "This bundle provides a way to validate JSON in request/response against a schema",
    "type": "symfony-bundle",
    "require": {
        "php": "^7.4",
        "ext-json": "*",
        "symfony/config": "^5.4",
        "symfony/http-foundation": "^5.4",
        "justinrainbow/json-schema": ">=5.2",
        "sensio/framework-extra-bundle": "^6.0",
        "psr/log": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.1"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Anton Sukhachev",
            "email": "mrsuh6@gmail.com",
            "role": "Author of mrsuh/json-validation-bundle"
        },
        {
            "name": "John Noel",
            "email": "john.noel@joipolloi.com",
            "role": "Author of joipolloi/json-validation-bundle"
        }
    ],
    "autoload": {
        "psr-4": { "Commander\\JsonValidationBundle\\": "" }
    }
}
