{
    "name": "commander/json-validation-bundle",
    "description": "This bundle provides a way to validate JSON in request/response against a schema using opis/json-schema validator",
    "license": "MIT",
    "type": "symfony-bundle",
    "authors": [
        {
            "name": "Marek Víger",
            "email": "marek.viger@commander.sk"
        },
        {
            "name": "Anton Sukhachev",
            "email": "mrsuh6@gmail.com",
            "role": "Author of mrsuh/json-validation-bundle"
        },
        {
            "name": "John Noel",
            "email": "john.noel@joipolloi.com",
            "role": "Author of joipolloi/json-validation-bundle"
        }
    ],
    "require": {
        "php": "^7.4",
        "ext-json": "*",
        "opis/json-schema": "^2.1",
        "psr/log": "^1.1",
        "sensio/framework-extra-bundle": "^6.1",
        "symfony/config": "^5.4",
        "symfony/http-foundation": "^5.4"
    },
    "require-dev": {
        "json-schema-org/json-schema-test-suite": ">=23",
        "phpunit/phpunit": "^9.1",
        "rector/rector": "^2.0"
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "json-schema-org/json-schema-test-suite",
                "version": "23.1.0",
                "source": {
                    "type": "git",
                    "url": "https://github.com/json-schema-org/JSON-Schema-Test-Suite",
                    "reference": "23.1.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Commander\\JsonValidationBundle\\": ""
        }
    },
    "config": {
        "sort-packages": true
    }
}
